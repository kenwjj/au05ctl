# Ulanzi AU05 Vibe Key: let the logged-in user open the vendor config channel (USB interface 3) without root.
# Install: sudo install -m644 udev/70-au05.rules /etc/udev/rules.d/ && sudo udevadm control --reload && sudo udevadm trigger -s hidraw
SUBSYSTEM=="hidraw", DEVPATH=="*:1.3/0003:FFF1:00DD.*", TAG+="uaccess"
